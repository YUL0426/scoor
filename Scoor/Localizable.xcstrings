    "로그아웃하면 가입 화면으로 돌아갑니다. 기기에 저장된 기록은 유지되며, 같은 계정으로 다시 로그인하면 복원됩니다.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトすると登録画面に戻ります。端末の記録は残り、同じアカウントでログインすると復元されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous reviendrez à l’écran d’inscription. Les entrées sur l’appareil sont conservées et seront restaurées à la reconnexion au même compte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você voltará para a tela de cadastro. Os registros no aparelho serão mantidos e restaurados ao entrar de novo na mesma conta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out returns you to the welcome screen. Entries on this device are kept and restored when you sign in with the same account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하면 가입 화면으로 돌아갑니다. 기기에 저장된 기록은 유지되며, 같은 계정으로 다시 로그인하면 복원됩니다."
          }
        }
      }
    },
    "로그아웃하면 가입 화면으로 돌아갑니다. 기기에 저장된 기록은 유지됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden gelangst du zur Registrierung. Lokale Daten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out returns you to the sign-up screen. Records saved on this device stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar sesión vuelves al registro. Los datos del dispositivo permanecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous reviendrez à l’écran d’inscription. Les entrées sur l’appareil sont conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトすると登録画面に戻ります。端末の記録は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하면 가입 화면으로 돌아갑니다. 기기에 저장된 기록은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后将返回注册页面，本机记录会保留。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
