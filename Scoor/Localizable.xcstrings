      }
    },
    "검토 결과는 내 토픽 제안의 심사 알림에서 확인할 수 있어요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は「自分の提案」の審査通知で確認できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat sera disponible dans les notifications de Mes propositions."
