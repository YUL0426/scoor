    "당신의 감정도 세계의 일부에요.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch dein Gefühl ist Teil der Welt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feeling is part of the world too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu emoción también es parte del mundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre humeur rejoint celles du monde entier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの気分も世界の記録のひとつに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 감정도 세계의 일부에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的感受也是世界的一部分。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu humor também faz parte do mundo."
          }
        }
      }
    },
    "당신의 한 점수가 세계의 맥박에 더해졌어요.": {
      "extractionState": "manual",
