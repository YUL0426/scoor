            "value": "Versão atual do documento: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current document version: "
          }
        }
      }
    },
    "계정 서비스 이용을 중단하면 새 서버 동기화와 게시를 멈춥니다. 기존 게시물은 자동으로 삭제되지 않으며, 콘텐츠 또는 계정 삭제를 별도로 요청할 수 있습니다. 선택 동의는 아래에서 따로 철회할 수 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 서비스 이용을 중단하면 새 서버 동기화와 게시를 멈춥니다. 기존 게시물은 자동으로 삭제되지 않으며, 콘텐츠 또는 계정 삭제를 별도로 요청할 수 있습니다. 선택 동의는 아래에서 따로 철회할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントサービスを停止すると、新たなサーバー同期と投稿が停止します。既存の投稿は自動削除されません。コンテンツやアカウントの削除は別途依頼できます。任意の同意は以下で個別に撤回できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrêt des services du compte suspend les nouvelles synchronisations et publications. Les contenus existants ne sont pas supprimés automatiquement ; vous pouvez les supprimer ou supprimer votre compte séparément. Les consentements facultatifs peuvent être retirés ci-dessous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper os serviços da conta pausa novas sincronizações e publicações. O conteúdo existente não é excluído automaticamente; você pode excluir o conteúdo ou a conta separadamente. Os consentimentos opcionais podem ser retirados abaixo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping account services pauses new synchronization and posting. Existing content is not automatically deleted; you can delete content or your account separately. Optional consent can be withdrawn below."
          }
        }
      }
    },
    "민감정보 동의 철회 및 해당 참여 내역 삭제": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감정보 동의 철회 및 해당 참여 내역 삭제"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機微情報への同意を撤回し、該当する回答を削除"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer le consentement aux données sensibles et supprimer ces réponses"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar o consentimento de dados sensíveis e excluir essas respostas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw sensitive-data consent and delete those responses"
          }
        }
      }
    },
    "철회하지 못했어요. 다시 시도해 주세요.": {
      "extractionState": "manual",
