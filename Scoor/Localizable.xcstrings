        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations privées, jugements sur l’apparence, attaques personnelles, propos haineux et publicités sont interdits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não publique dados pessoais de pessoas comuns, avaliações de aparência, ataques pessoais, discurso de ódio ou propaganda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not post private information, judgments about people’s appearance, personal attacks, hate, or advertising."
