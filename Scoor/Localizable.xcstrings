    "Scoor는 감정을 점수로 나누는 곳이에요.\n서로의 하루를 존중해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoor는 감정을 점수로 나누는 곳이에요.\n서로의 하루를 존중해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お互いの一日を尊重して投稿しましょう。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre journée dans le respect des autres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu dia respeitando as outras pessoas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your day respectfully."
          }
        }
      }
    },
    "괴롭힘·혐오 표현 금지": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "괴롭힘·혐오 표현 금지"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嫌がらせ・差別表現は禁止"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de harcèlement ni de haine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assédio ou discurso de ódio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No harassment or hate"
          }
        }
      }
    },
    "특정인이나 집단을 향한 모욕, 차별, 위협은 삭제되고 계정이 제한될 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정인이나 집단을 향한 모욕, 차별, 위협은 삭제되고 계정이 제한될 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "侮辱、差別、脅迫は削除やアカウント制限の対象になる場合があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les insultes, discriminations et menaces peuvent entraîner une suppression et des restrictions du compte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofensas, discriminação e ameaças podem resultar em remoção e restrições à conta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abuse, discrimination and threats may result in removal and account restrictions."
          }
        }
      }
    },
    "타인의 개인정보 게시 금지": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타인의 개인정보 게시 금지"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人のプライバシーを尊重"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respectez la vie privée des autres"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeite a privacidade das outras pessoas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect other people’s privacy"
          }
        }
      }
    },
    "실명, 연락처, 주소 등을 다른 사람 동의 없이 올릴 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실명, 연락처, 주소 등을 다른 사람 동의 없이 올릴 수 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人の許可なく、個人情報を投稿しないでください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne publiez pas les informations privées d’autrui sans son autorisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não publique dados pessoais de outras pessoas sem permissão."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not post someone else’s private details without permission."
          }
        }
      }
    },
    "스팸·광고 금지": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스팸·광고 금지"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スパム・広告は禁止"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de spam ni de publicité"
          }
        },
        "pt-BR": {
