            "state": "translated",
            "value": "No spam or advertising"
          }
        }
      }
    },
    "반복 게시나 홍보 목적의 글은 삭제됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 게시나 홍보 목적의 글은 삭제됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しの投稿や宣伝目的の投稿は削除される場合があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications répétitives ou promotionnelles peuvent être supprimées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicações repetitivas ou promocionais podem ser removidas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetitive or promotional posts may be removed."
          }
        }
      }
    },
    "위태로운 순간에는": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위태로운 순간에는"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安心して使えるコミュニティに"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préservons la sécurité de la communauté"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos manter a comunidade segura"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the community safe"
          }
        }
      }
    },
    "자해나 자살을 부추기는 내용은 금지예요. 힘든 사람을 발견하면 신고해 주세요 — 처벌이 아니라 도움으로 연결됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자해나 자살을 부추기는 내용은 금지예요. 힘든 사람을 발견하면 신고해 주세요 — 처벌이 아니라 도움으로 연결됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自傷や自殺を促す内容は禁止です。有害な投稿は通報してください。通報機能は緊急通報窓口ではありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contenus incitant à l’automutilation ou au suicide sont interdits. Signalez les contenus dangereux. Le signalement n’est pas un service d’urgence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É proibido incentivar automutilação ou suicídio. Denuncie conteúdos perigosos. As denúncias não são um serviço de emergência."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content encouraging self-harm or suicide is prohibited. Report harmful content; reports are not an emergency service."
          }
        }
      }
    },
    "신고와 차단": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고와 차단"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通報とブロック"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler et bloquer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Denunciar e bloquear"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report and block"
          }
        }
      }
    },
    "불편한 글은 언제든 신고하거나 그 사용자를 차단할 수 있어요. 신고를 검토하고 필요한 조치를 취합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불편한 글은 언제든 신고하거나 그 사용자를 차단할 수 있어요. 신고를 검토하고 필요한 조치를 취합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿の通報やユーザーのブロックができます。通報を確認し、必要な対応を行います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez signaler du contenu et bloquer des personnes. Nous examinons les signalements et prenons les mesures appropriées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode denunciar conteúdo e bloquear pessoas. Analisamos as denúncias e tomamos as medidas necessárias."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can report content and block users. We review reports and take appropriate action."
          }
        }
      }
    },
    "커뮤니티 가이드라인": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
