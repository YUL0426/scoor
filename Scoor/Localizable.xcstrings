    "로그인은 완료됐지만 가입을 마무리하지 못했어요. 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 완료됐지만 가입을 마무리하지 못했어요. 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインできましたが、登録を完了できませんでした。もう一度お試しください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a réussi, mais la configuration n’a pas pu être terminée. Réessayez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entrou, mas não foi possível concluir o cadastro. Tente de novo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re signed in, but we couldn’t finish setup. Please try again."
          }
        }
      }
    },
