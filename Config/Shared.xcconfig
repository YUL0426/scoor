// Shared build configuration for the Scoor app target.
//
// GID_CLIENT_ID: Google OAuth client id (format: <id>.apps.googleusercontent.com).
// Empty by default — the app hides Google Sign-In when it is not provisioned.
//
// SUPABASE_URL / SUPABASE_ANON_KEY: backend endpoint + public anon key.
// Empty by default — the app runs fully local (SwiftData only) when unset, so
// previews, tests, and un-provisioned checkouts keep working. The anon key is a
// public client credential by design; the service-role key must NEVER appear here.
//
// Put real values in Config/Secrets.xcconfig (git-ignored); see
// Config/Secrets.xcconfig.example for setup steps.

GID_CLIENT_ID =

// xcconfig treats "//" as a comment even inside a value, so an https:// URL
// cannot be written literally here. We store the host only and SupabaseConfig
// prepends the scheme. (This is a real xcconfig limitation, not a style choice.)
SUPABASE_HOST =
SUPABASE_ANON_KEY =

#include? "Secrets.xcconfig"
