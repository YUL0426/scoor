<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Google OAuth client id (BUG-002). Injected from GID_CLIENT_ID in
	     Config/Secrets.xcconfig (git-ignored). Empty ⇒ Google Sign-In is hidden
	     in the app and GoogleSignInController.signIn() throws .notConfigured.
	     The rest of the Info.plist is still generated by Xcode
	     (GENERATE_INFOPLIST_FILE = YES merges this file on top). -->
	<key>GIDClientID</key>
	<string>$(GID_CLIENT_ID)</string>
	<!-- Supabase backend (spec-13 Phase 0/1). Injected from Config/Secrets.xcconfig.
	     Empty ⇒ SupabaseConfig.current is nil and the app runs local-only
	     (SwiftData services), so previews and un-provisioned checkouts still build.
	     SupabaseHost is scheme-less because xcconfig treats "//" as a comment. -->
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
</dict>
</plist>
