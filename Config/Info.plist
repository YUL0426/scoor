<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Google OAuth client id (BUG-002). Injected from GID_CLIENT_ID in
	     Config/Secrets.xcconfig (git-ignored). Empty ⇒ Google Sign-In is hidden
	     in the app and GoogleSignInController.signIn() throws .notConfigured.
	     The rest of the Info.plist is still generated by Xcode
	     (GENERATE_INFOPLIST_FILE = YES merges this file on top). -->
	<key>GIDClientID</key>
	<string>$(GID_CLIENT_ID)</string>
</dict>
</plist>
