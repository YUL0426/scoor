// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in real values.
//
// Google Sign-In (resolves BUG-002):
// 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client id
//    (type: iOS, bundle id: com.euro.Scoor).
// 2. Paste the client id below.
// 3. The redirect URI com.googleusercontent.apps.<id>:/oauth2redirect/google is
//    derived automatically by GoogleSignInController; no CFBundleURLTypes needed
//    (ASWebAuthenticationSession consumes the callback internally).

GID_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com

// Supabase backend (spec-13 Phase 0/1):
// 1. https://supabase.com/dashboard → New project (region: Northeast Asia (Seoul)
//    for the p95 < 600ms target in spec-13 §11).
// 2. Project Settings → API → copy "Project URL" and the "anon public" key.
// 3. SUPABASE_HOST is the URL *without* the https:// scheme — xcconfig parses
//    "//" as a comment, so the scheme cannot be written here. SupabaseConfig
//    prepends it at runtime.
// 4. Apply the schema: supabase link --project-ref <ref> && supabase db push
//    (migrations live in supabase/migrations/).
//
// The anon key is a public client credential — it is safe in the app bundle
// because every table is protected by RLS. The service-role key bypasses RLS
// entirely and must never be placed in this file or any client build.

SUPABASE_HOST = abcdefghijklm.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.anon-key
