# Admin auth (P0-8) — copy to .env.local (git-ignored) and fill in.
# All three are required; when any is missing, sign-in fails closed (503).

# Login email for the single admin account.
ADMIN_EMAIL=admin@scoor.app

# SHA-256 hex of the admin password. Generate with:
#   printf '%s' 'your-strong-password' | shasum -a 256 | cut -d' ' -f1
ADMIN_PASSWORD_SHA256=

# Secret for signing session cookies. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Scoor backend (World topic curation) ──────────────────────────────
# Both are server-only: no NEXT_PUBLIC_ prefix, so they never reach the browser
# bundle. Without them the topics screen returns 503 instead of falling back to
# mock data. Supabase dashboard → Project Settings → API.
#
# The service-role key bypasses every RLS policy. Treat it like a production
# database password: never commit it, never expose it to the client.
SUPABASE_URL=https://ebxdbadcejbytixumxrj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
